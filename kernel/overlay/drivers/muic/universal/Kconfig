#
# MUIC devices
#

comment "MUIC configs"

config MUIC_UNIVERSAL
  bool "UNIVERSAL MUIC"
	depends on USE_MUIC
	default n
	help
	  If you say yes here you will get support for various MUIC chips.

config MUIC_UNIVERSAL_SM5703
  bool "SM5703 MUIC"
	depends on USE_MUIC
	default n
	help
	  If you say yes here you will get support for the SM5703 MUIC chip.

config MUIC_UNIVERSAL_SM5705
	bool "SM5705 MUIC"
	depends on USE_MUIC
	default n
	help
	  If you say yes here you will get support for the SM5705 MUIC chip.

config MUIC_UNIVERSAL_SM5705_AFC
	bool "SM5705 MUIC AFC"
	depends on USE_MUIC
	default n
	help
	  If you say yes here you will get support for the SM5705 MUIC
	  AFC feature.

config MUIC_UNIVERSAL_SM5504
  bool "SM5504 MUIC"
	depends on USE_MUIC
	default n
	help
	  If you say yes here you will get support for the SM5504 MUIC chip.

config MUIC_PINCTRL
  bool "MUIC PINCTRL"
	depends on USE_MUIC
	default n
	help
	  If you say yes here you will get support for the Pinctrl in MUIC driver.

config MUIC_SUPPORT_RUSTPROOF
	bool "MUIC Disable UART"
	depends on !SEC_FACTORY
	default n
	help
	 This option will disable the UART to prevent the rusting of the
	 IF Connector in the case of Kmini Devices.

config SM5705_SUPPORT_LANHUB
	bool "LANHUB Support for SM5705 MUIC"
	depends on MUIC_UNIVERSAL_SM5705
	default n
	help
	 This option will provide USB LANHUB support to SM5705 MUIC based
	 devices.

config MUIC_SUPPORT_GAMEPAD
	bool "GAMEPAD Support for MUIC"
	depends on MUIC_UNIVERSAL
	default n
	help
	 This option will provide GAMEPAD support to MUIC based
	 devices.


config C5_MUIC_RESUME_IRQ_RECHECK
	bool "C5 SM5705 pending MUIC IRQ check after resume"
	depends on ARCH_MSM8952 && PM && GPIOLIB
	depends on MUIC_UNIVERSAL && MUIC_UNIVERSAL_SM5705
	depends on MUIC_UNIVERSAL_SM5705_AFC
	default n
	help
	  On the C5 board, a falling-edge SM5705 interrupt may remain low
	  across suspend. Re-enabling TLMM can clear the pending edge.
	  After re-enabling the IRQ, sample the existing input once and
	  run the existing serialized handler once if it is low. Expose
	  read-only per-device resume counters, without polling, changing
	  GPIO direction, IRQ type or other boards' interrupt handling.


config C5_LEGACY_UART3_NOTIFY
	bool "C5 legacy MUIC UART jig notification"
	depends on C5_RECOVERY_ONLY && ARCH_MSM8952 && ARM64 && OF
	depends on !CPU_BIG_ENDIAN && !MODULES
	depends on MUIC_UNIVERSAL && MUIC_UNIVERSAL_SM5705
	depends on MUIC_NOTIFIER && SWITCH
	default n
	select UART3
	help
	  Restore the legacy uart3 switch notification for UART-OFF jig
	  attach/detach. This is a software notification, not a UART driver
	  or a request to change the MUIC routing, clocks or registers.

config UART3
	bool
