#
# Zinitix zt75xx Touchscreen driver configuration
#

config TOUCHSCREEN_ZT7538
	tristate "ZINITIX zt7538 I2C touchscreen driver"
	depends on I2C && OF && GPIOLIB && REGULATOR && PM_SLEEP
	depends on ARCH_MSM8952
	select SEC_CLASS
	select MUIC_NOTIFIER
	select C5_LCD_ID
	help
	  Say Y here if you have Zinitix zt7538 I2C touchscreen,
	  such as zt75xx, connected to your system.

	  If unsure, say N.

	  To compile this driver as a module, choose M here: the
	  module will be called zt7538.

config SECURE_TOUCH
	bool "ZT7538 secure-touch sysfs interface"
	depends on TOUCHSCREEN_ZT7538
	help
	  Compile the accepted C5 secure-touch interface. Runtime firmware
	  ownership and clocks require independent hardware acceptance.

config MUIC_NOTIFIER
	bool
	select SEC_CLASS

config SEC_CLASS
	bool
	select SOC_SAMSUNG

config C5_LCD_ID
	bool
