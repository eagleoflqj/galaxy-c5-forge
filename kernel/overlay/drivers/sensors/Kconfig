config SENSORS_SSC
	bool "Enable Sensors Driver Support for SSC"
	help
	  Add support for sensors SSC driver.
	  This driver is used for exercising sensors use case,
	  time syncing with ADSP clock.

config SENSORS_CORE
    bool "C5 Samsung sensor class"
    depends on C5_RECOVERY_ONLY && INPUT
    default n

config SENSORS_BHI
    bool "C5 Bosch BHA250 sensor hub"
    depends on C5_RECOVERY_ONLY && I2C && INPUT && SENSORS_CORE && IIO && IIO_BUFFER && IIO_KFIFO_BUF
    default n

config SENSORS_TMD3700
    bool "C5 original TMD3700 light and proximity"
    depends on C5_RECOVERY_ONLY && I2C && INPUT && SENSORS_CORE && OF && GPIOLIB
    default n

config SENSORS_TMD3700_RESET_DEFENCE_CODE
    bool "Original TMD3700 sensor-hub reset callbacks"
    depends on SENSORS_TMD3700
    default n

config SENSORS_YAS539
    bool "C5 original Yamaha YAS539 magnetic sensor"
    depends on C5_RECOVERY_ONLY && I2C && INPUT && SENSORS_CORE && OF
    default n

config SENSORS_YAS_RESET_DEFENCE_CODE
    bool "Original YAS539 sensor-hub reset callbacks"
    depends on SENSORS_YAS539
    default n

config C5_SSC_TIMER_COMPAT
	bool "C5 legacy SSC physical slow-timer interface"
	depends on ARM64 && QTI_MPM_C5LTE && !SENSORS_SSC
	default n
	help
	  Provide the legacy /dev/sensors slow-timer ioctl for the fixed C5
	  profile using the already registered physical counter frame and
	  cached native read permission. This does not load SSC firmware,
	  register SLPI controls or change the native timer implementation.
