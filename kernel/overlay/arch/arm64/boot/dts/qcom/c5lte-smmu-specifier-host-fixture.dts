			qcom,fixed-context-bank = <3>;
			forge,legacy-reg = <0x1e23000 0x1000>;
			forge,legacy-interrupts = <0 54 0 0 54 0>;
			iommus = <&apps 0x880 0x3>, <&apps 0x884 0x0>, <&apps 0x888 0x2>;
			forge,secure-context;
		};
		apps_cb4: apps-cb4 {
