/* HOST-ONLY stream-specifier/legacy-domain fixture. NEVER a board DT.
 * C5 baseline DTB: 83e02661e33cc35a25c6fee66abb0e2f492e2dc854b79a396a8eb90817869713.
 * Providers deliberately do NOT match any native/legacy SMMU driver.
 * forge,* properties are evidence metadata, not new runtime bindings.
 * The fixed-bank consumer property is tested with nonruntime providers.
 * No IRQ gaps, hardware bank count, CB ownership or handoff is guessed.
 */
/dts-v1/;

/ {
	compatible = "samsung,c5lte-smmu-specifier-host-fixture";
	providers {
		apps: apps {
			#iommu-cells = <2>;
			forge,baseline-controller = "/soc/qcom,iommu@1e00000";
			forge,legacy-reg = <0x1e00000 0x40000>;
			forge,legacy-interrupts = <0x0 0x29 0x0 0x0 0x26 0x0>;
			forge,secure-id = <17>;
		};
		gpu: gpu {
			#iommu-cells = <2>;
			forge,baseline-controller = "/soc/qcom,iommu@1f00000";
			forge,legacy-reg = <0x1f00000 0x10000>;
			forge,legacy-interrupts = <0x0 0x2b 0x0 0x0 0x2a 0x0>;
			forge,secure-id = <18>;
		};
	};
	masters {
		apps_cb2: apps-cb2 {
			forge,baseline-context = "/soc/qcom,iommu@1e00000/qcom,iommu-ctx@1e22000";
			forge,legacy-context-bank = <2>;
			qcom,fixed-context-bank = <2>;
			forge,legacy-reg = <0x1e22000 0x1000>;
			forge,legacy-interrupts = <0 53 0 0 53 0>;
			iommus = <&apps 0x8c0 0x0>, <&apps 0x8c6 0x0>;
			forge,secure-context;
		};
		apps_cb3: apps-cb3 {
			forge,baseline-context = "/soc/qcom,iommu@1e00000/qcom,iommu-ctx@1e23000";
