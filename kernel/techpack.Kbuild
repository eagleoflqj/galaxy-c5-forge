# Preserve the link and exported-header order of the accepted c5lte build.
techpack-dirs := audio-legacy c5-camera c5-vidc xiaomi-msm8937 stub camera-legacy c5-peripherals c5-audio camera-legacy-m xiaomi-sdm439 audio
obj-y += stub/ $(addsuffix /,$(techpack-dirs))
header-y += $(addsuffix /include/uapi/,$(techpack-dirs))
