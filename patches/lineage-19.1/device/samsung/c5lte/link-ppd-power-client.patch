+LOCAL_MODULE := libshims_ppd_power
+LOCAL_SRC_FILES := ppd_power.cpp
+LOCAL_MULTILIB := 64
+LOCAL_SHARED_LIBRARIES := libbinder libpowermanager libutils
 include $(BUILD_SHARED_LIBRARY)
 
