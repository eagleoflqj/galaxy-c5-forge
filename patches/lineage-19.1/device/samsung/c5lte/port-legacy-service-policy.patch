diff --git a/sepolicy/peripheral_manager.te b/sepolicy/peripheral_manager.te
new file mode 100644
--- /dev/null
+++ b/sepolicy/peripheral_manager.te
@@ -0,0 +1,5 @@
+# CSA1 clients use the framework Binder driver to reach the peripheral manager.
+type binder_per_mgr_service, service_manager_type;
+binder_use(vendor_per_mgr)
+add_service(vendor_per_mgr, binder_per_mgr_service)
+allow { audioserver rild system_server } binder_per_mgr_service:service_manager find;
diff --git a/sepolicy/service_contexts b/sepolicy/service_contexts
new file mode 100644
--- /dev/null
+++ b/sepolicy/service_contexts
@@ -0,0 +1 @@
+vendor.qcom.PeripheralManager u:object_r:binder_per_mgr_service:s0
diff --git a/sepolicy/legacy_data.te b/sepolicy/legacy_data.te
new file mode 100644
--- /dev/null
+++ b/sepolicy/legacy_data.te
@@ -0,0 +1,12 @@
+# CSA1 keeps these directories in core /data across system upgrades.
+typeattribute biometrics_data_file core_data_file_type;
+typeattribute gps_data_file core_data_file_type;
+
+# Keep the existing /data/time label separate from Qualcomm's /data/vendor/time.
+type time_data_file, file_type, data_file_type, core_data_file_type;
+
+allow time_daemon time_data_file:dir w_dir_perms;
+allow time_daemon time_data_file:file create_file_perms;
+
+# The C5 fstab mounts calibration storage at the root rather than /mnt/vendor.
+allow init persist_file:dir mounton;
diff --git a/sepolicy/legacy_keymaster.te b/sepolicy/legacy_keymaster.te
new file mode 100644
--- /dev/null
+++ b/sepolicy/legacy_keymaster.te
@@ -0,0 +1,4 @@
+# The CSA1 TEE listener signals readiness to both hardware-backed HALs.
+set_prop(tee, c5_keymaster_ready_prop)
+get_prop(hal_keymaster_default, c5_keymaster_ready_prop)
+get_prop(hal_gatekeeper_default, c5_keymaster_ready_prop)
