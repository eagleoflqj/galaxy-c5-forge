Declare the legacy HIDL fingerprint sensor for Android 12L lock-screen authentication.

--- a/overlay/frameworks/base/core/res/res/values/config.xml
+++ b/overlay/frameworks/base/core/res/res/values/config.xml
@@ -328,6 +328,11 @@
     <!-- Should the pinner service pin the Camera application? -->
     <bool name="config_pinnerCameraApp">true</bool>
 
+    <!-- Home-key fingerprint sensor: ID 0, fingerprint modality, Class 2. -->
+    <string-array name="config_biometric_sensors" translatable="false">
+        <item>0:2:255</item>
+    </string-array>
+
     <!-- For performance and storage reasons, limit the number of fingerprints per user -->
     <integer name="config_fingerprintMaxTemplatesPerUser">4</integer>
 
