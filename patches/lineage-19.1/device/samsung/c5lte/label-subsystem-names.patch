+# The Qualcomm peripheral manager reads these subsystem names during discovery.
+genfscon sysfs /devices/soc.0/1de0000.qcom,venus/subsys0/name u:object_r:sysfs_data:s0
+genfscon sysfs /devices/soc.0/c200000.qcom,lpass/subsys1/name u:object_r:sysfs_data:s0
+genfscon sysfs /devices/soc.0/a21b000.qcom,pronto/subsys2/name u:object_r:sysfs_data:s0
+genfscon sysfs /devices/soc.0/4080000.qcom,mss/subsys3/name u:object_r:sysfs_data:s0
+
+genfscon sysfs /devices/platform/battery/power_supply u:object_r:sysfs_batteryinfo:s0
+genfscon sysfs /devices/platform/i2c@11/i2c-12/12-0071/power_supply u:object_r:sysfs_batteryinfo:s0
+genfscon sysfs /devices/platform/sec-multi-charger/power_supply u:object_r:sysfs_batteryinfo:s0
+genfscon sysfs /devices/soc.0/soc:i2c@13/i2c-9/9-0049/sm5705-charger/power_supply u:object_r:sysfs_batteryinfo:s0
+genfscon sysfs /devices/soc.0/soc:i2c@13/i2c-9/9-0058/power_supply u:object_r:sysfs_batteryinfo:s0
+genfscon sysfs /devices/soc.0/1a00000.qcom,mdss_mdp/1a00000.qcom,mdss_mdp:qcom,mdss_fb_primary/leds/lcd-backlight u:object_r:sysfs_leds:s0
