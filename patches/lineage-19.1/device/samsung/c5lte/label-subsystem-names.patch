+genfscon sysfs /devices/soc.0/1a00000.qcom,mdss_mdp/caps u:object_r:sysfs_graphics:s0
+
+# rmt_storage discovers the modem's shared buffer through these UIO attributes.
+genfscon sysfs /devices/soc.0/0.qcom,rmtfs_sharedmem/uio/uio0/name u:object_r:sysfs_uio_file:s0
+genfscon sysfs /devices/soc.0/0.qcom,rmtfs_sharedmem/uio/uio0/version u:object_r:sysfs_uio_file:s0
+genfscon sysfs /devices/soc.0/0.qcom,rmtfs_sharedmem/uio/uio0/maps/map0/addr u:object_r:sysfs_uio_file:s0
+genfscon sysfs /devices/soc.0/0.qcom,rmtfs_sharedmem/uio/uio0/maps/map0/size u:object_r:sysfs_uio_file:s0
