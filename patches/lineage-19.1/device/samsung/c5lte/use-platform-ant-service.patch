Platform change: https://github.com/LineageOS/android/commit/8e5c8171fd2f3a84de29e6a4769698867cd06bc1

diff --git a/product/ant.mk b/product/ant.mk
--- a/product/ant.mk
+++ b/product/ant.mk
@@ -1,8 +1,2 @@
 # ANT+
-PRODUCT_PACKAGES += \
-    AntHalService \
-    com.dsi.ant.antradio_library
-
-# Permissions
-PRODUCT_COPY_FILES += \
-    external/ant-wireless/antradio-library/com.dsi.ant.antradio_library.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/com.dsi.ant.antradio_library.xml
+PRODUCT_PACKAGES += AntHalService
