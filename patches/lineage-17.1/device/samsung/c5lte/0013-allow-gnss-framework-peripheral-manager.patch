diff --git a/sepolicy/hal_gnss_default.te b/sepolicy/hal_gnss_default.te
--- a/sepolicy/hal_gnss_default.te
+++ b/sepolicy/hal_gnss_default.te
@@ -1,3 +1,9 @@
 allow hal_gnss_default gps_data_file:dir create_dir_perms;
 allow hal_gnss_default gps_data_file:file create_file_perms;
 allow hal_gnss_default location_data_file:dir r_dir_perms;
+
+# This legacy platform registers vendor.qcom.PeripheralManager with the
+# framework servicemanager, while the common QCOM GNSS policy only grants its
+# client access through vndservicemanager.
+binder_use(hal_gnss_default)
+allow hal_gnss_default binder_per_mgr_service:service_manager find;
