diff --git a/Android.mk b/Android.mk
index b2d4314..0edee3c 100644
--- a/Android.mk
+++ b/Android.mk
@@ -18,4 +18,17 @@ LOCAL_PATH := $(call my-dir)
 
 ifeq ($(TARGET_DEVICE),c5lte)
 
+# The CSA1 amplifier imports ARM symbols versioned LIBC_PRIVATE. Check them
+# against the runtime libc that supplies them on the phone.
+include $(CLEAR_VARS)
+LOCAL_MODULE := libtfa98xx
+LOCAL_MODULE_OWNER := samsung
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_MULTILIB := 32
+LOCAL_SRC_FILES := proprietary/lib/libtfa98xx.so
+LOCAL_STRIP_MODULE := false
+LOCAL_SHARED_LIBRARIES := libcutils libutils liblog libc++ libc.com.android.runtime libdl libm
+include $(BUILD_PREBUILT)
+
 endif
