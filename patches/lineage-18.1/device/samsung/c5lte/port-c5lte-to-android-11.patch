diff --git b/libshims/ril_audio.cpp b/libshims/ril_audio.cpp
new file mode 100644
index 0000000..b2a154a
--- /dev/null
+++ b/libshims/ril_audio.cpp
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <media/AudioSystem.h>
+
+#include <mutex>
+
+// The CSA1 RIL replaces one callback. Android 11 registers callbacks by handle.
+extern "C" void
+setRilAudioErrorCallback(android::audio_error_callback callback) asm(
+    "_ZN7android11AudioSystem16setErrorCallbackEPFviE");
+
+void setRilAudioErrorCallback(android::audio_error_callback callback) {
+  static std::mutex lock;
+  static uintptr_t handle;
+  const std::lock_guard<std::mutex> guard(lock);
+  if (handle != 0) {
+    android::AudioSystem::removeErrorCallback(handle);
+  }
+  handle = callback ? android::AudioSystem::addErrorCallback(callback) : 0;
+}
