diff --git a/rootdir/etc/init.recovery.qcom.rc b/rootdir/etc/init.recovery.qcom.rc
new file mode 100644
--- /dev/null
+++ b/rootdir/etc/init.recovery.qcom.rc
@@ -0,0 +1,9 @@
+import /init.recovery.qcom.power.rc
+
+on early-init
+    # Android 28 adbd uses FunctionFS AIO by default, which this 3.10 kernel does not support.
+    setprop sys.usb.ffs.aio_compat 1
+
+on fs
+    wait /dev/block/platform/soc.0/${ro.boot.bootdevice}
+    symlink /dev/block/platform/soc.0/${ro.boot.bootdevice} /dev/block/bootdevice
