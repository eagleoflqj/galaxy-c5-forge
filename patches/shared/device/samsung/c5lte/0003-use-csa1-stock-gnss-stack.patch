+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace {
+
+std::string hexValue(uint32_t value) {
+    char text[11];
+    std::snprintf(text, sizeof(text), "0x%x", value);
+    return text;
+}
+
+void appendFlag(std::string* output, const char* name) {
+    if (!output->empty()) {
+        output->append(" | ");
+    }
+    output->append(name);
+}
+
+}  // namespace
+
+std::string gnssNiEncodingToString(int32_t value)
+        __asm__("_ZN7android8hardware4gnss4V1_08toStringENS2_15IGnssNiCallback18GnssNiEncodingTypeE");
+
+std::string gnssNiEncodingToString(int32_t value) {
+    switch (value) {
+        case 0:
+            return "ENC_NONE";
+        case 1:
+            return "ENC_SUPL_GSM_DEFAULT";
+        case 2:
+            return "ENC_SUPL_UTF8";
+        case 3:
+            return "ENC_SUPL_UCS2";
+        case -1:
+            return "ENC_UNKNOWN";
+        default:
+            return hexValue(static_cast<uint32_t>(value));
+    }
+}
+
+std::string gnssUserResponseToString(uint8_t value)
+        __asm__("_ZN7android8hardware4gnss4V1_08toStringENS2_15IGnssNiCallback20GnssUserResponseTypeE");
+
+std::string gnssUserResponseToString(uint8_t value) {
+    switch (value) {
+        case 1:
+            return "RESPONSE_ACCEPT";
+        case 2:
+            return "RESPONSE_DENY";
+        case 3:
+            return "RESPONSE_NORESP";
+        default:
+            return hexValue(value);
+    }
+}
+
+std::string gnssNotifyFlagsToString(uint32_t value)
+        __asm__("_ZN7android8hardware4gnss4V1_08toStringINS2_15IGnssNiCallback17GnssNiNotifyFlagsEEENSt3__112basic_stringIcNS6_11char_traitsIcEENS6_9allocatorIcEEEEj");
+
+std::string gnssNotifyFlagsToString(uint32_t value) {
+    std::string output;
+    uint32_t described = 0;
+    if ((value & 1U) != 0U) {
+        appendFlag(&output, "NEED_NOTIFY");
+        described |= 1U;
+    }
+    if ((value & 2U) != 0U) {
+        appendFlag(&output, "NEED_VERIFY");
+        described |= 2U;
+    }
+    if ((value & 4U) != 0U) {
+        appendFlag(&output, "PRIVACY_OVERRIDE");
+        described |= 4U;
+    }
+    if (value != described) {
+        const std::string unknown = hexValue(value & ~described);
+        appendFlag(&output, unknown.c_str());
+    }
+    output.append(" (");
+    output.append(hexValue(value));
+    output.push_back(')');
+    return output;
+}
